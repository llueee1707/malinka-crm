# Copy this file to .env and fill in real values before first run.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Set to false for clean production install (no demo seed data)
SEED_DEMO_DATA=false

# These three create the very first user on a fresh database.
# Change them before the first run on the client's laptop.
BOOTSTRAP_DIRECTOR_LOGIN=Admin
BOOTSTRAP_DIRECTOR_PASSWORD=change-this-password
BOOTSTRAP_DIRECTOR_FULL_NAME=Administrator
